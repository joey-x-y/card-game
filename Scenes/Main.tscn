[node name="RichTextLabel" type="RichTextLabel" parent="ColorRect2/MarginContainer" unique_id=901328311]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 34
text = "This is a 4-person game of poker with 2 teams. The player with the best hand gets a win for their team.

Each player gets 4 cards, and there are 2 river cards in the center. 1 is revealed immediately, 2 is revealed at the end of the round.

Hands are calculated based off of your personal cards and the river cards combined.

There are two phases. 1. Discard phase. You choose cards that you want to discard and replace with a new card from the deck. 2. Trading phase. You choose cards in your own hand and your teammate's hand to swap. You must swap an equal amount. After the swap, the 2nd river card is revealed and the winner is decided."
horizontal_alignment = 1

